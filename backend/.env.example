# Database URL (SQLite default for dev; replace with postgresql://user:pass@host/db for Postgres)
DATABASE_URL=sqlite:///./karuthal_dev.db

# JWT Secret Key (Required: application fails to start if not set)
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars

# Allowed CORS Origins (comma-separated, no wildcards)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Enforce officer district scope on protected endpoints (true / false)
ENFORCE_DISTRICT_SCOPE=true

# Demo officer password (used ONLY by scripts/seed_demo.py)
DEMO_OFFICER_PASSWORD=replace_with_demo_password
